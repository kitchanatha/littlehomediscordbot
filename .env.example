DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

GOOGLE_SHEET_ID=
# Optional — separate spreadsheet holding Game_Roster_CombatPower (the durable in-game roster),
# kept apart from the main sheet for cleaner organization. Share it with the service account
# email too. Leave blank to keep everything in the main GOOGLE_SHEET_ID sheet instead.
GAME_ROSTER_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Text channel where a registered member leaving the Discord server is announced. Leave blank to disable.
MEMBER_UPDATE_CHANNEL_ID=
# Comma-separated Discord role IDs allowed to run admin-only commands (/assign, /register_all, /queue_add, /queue_remove).
ASSIGN_ROLE_IDS=

# Set to true only if "Server Members Intent" is enabled in Discord Developer Portal
ENABLE_MEMBERS_INTENT=false

# War attendance (optional — leave blank to disable these features)
# Voice channel(s) members join during Sunday War. Joining one auto-marks them
# present ("มา") for today on the attendance sheet + their class tab. Comma-separated.
WAR_CHECKIN_VOICE_CHANNEL_IDS=
# Text channel where /war_leave is allowed (marks "แจ้งลาแล้ว"). Leave blank to allow it anywhere.
WAR_LEAVE_CHANNEL_ID=
# Text channel where members post the guild's registration-form template as a plain message;
# the bot auto-registers them from it. Requires "Message Content Intent" enabled in the
# Discord Developer Portal. Leave blank to disable.
AUTO_REGISTER_CHANNEL_ID=
# Text channel where members post a name/class change request as a plain message; the bot
# applies it to their own registered profile automatically. Requires "Message Content Intent"
# enabled in the Discord Developer Portal. Leave blank to disable.
NAME_CLASS_CHANGE_CHANNEL_ID=

# Optional — lets /upload_item_image reach the guild-item-reservation website's Supabase
# project, so admins can add an item's name+icon to the shared catalog from Discord too. All
# three must be set together or the command stays disabled. BOT_SHARED_SECRET must match the
# same value set on that project's queue-bridge Edge Function
# (`supabase secrets set BOT_SHARED_SECRET=...`).
SUPABASE_FUNCTIONS_URL=
SUPABASE_ANON_KEY=
BOT_SHARED_SECRET=
